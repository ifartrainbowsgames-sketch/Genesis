{
  "name": "genesis-workspace",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "sidecar:build:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/build-sidecar.ps1",
    "desktop:dev": "npm --prefix apps/desktop run tauri dev",
    "desktop:build": "npm --prefix apps/desktop run tauri build",
    "desktop:dev:windows": "npm run sidecar:build:windows && npm run desktop:dev",
    "desktop:build:windows": "npm run sidecar:build:windows && npm run desktop:build"
  }
}
