# Core
APP_NAME=Genesis
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WEB_ORIGIN=http://localhost:3000
WORKSPACE_ROOT=./workspace
# Optional semicolon-separated parent folders the in-app repository selector may browse.
# Example: C:/Code;D:/Projects
WORKSPACE_ALLOWED_ROOTS=

# AI provider default. The packaged desktop injects this from the installer setup wizard.
# Source/developer mode may set: ollama | openai | anthropic
GENESIS_DEFAULT_PROVIDER=ollama

# Database
DATABASE_URL=postgresql+asyncpg://genesis:genesis@localhost:5432/genesis

# Local AI (recommended)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional cloud providers. Packaged desktop keys are stored in the OS credential store instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional GitHub adapter (fine-grained token recommended)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Optional MCP v2 Streamable HTTP servers. Genesis only connects to endpoints listed here.
# Example: [{"name":"local-tools","url":"http://127.0.0.1:9000/mcp","enabled":true}]
MCP_SERVERS_JSON=[]

# Optional external workers. These are server-side allowlisted and external execution is approval-gated.
# Command workers use fixed argv with shell disabled and receive the task on stdin.
# Example command adapter for a locally installed agent CLI:
# [{"name":"agent-cli","type":"command","argv":["agent-cli","--print"],"cwd":".","enabled":true}]
# Example HTTP adapter:
# [{"name":"openhands","type":"http","url":"http://127.0.0.1:3100/run","enabled":true}]
EXTERNAL_WORKERS_JSON=[]
EXTERNAL_WORKER_TIMEOUT_SECONDS=300
EXTERNAL_WORKER_MAX_OUTPUT_BYTES=200000

# Durable bounded schedules. Schedule requests run the Genesis team; they do not auto-apply workspace changes.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=15

# Source-tracked web research. `docker compose up -d searxng` starts the bundled local broker.
SEARXNG_URL=http://127.0.0.1:8080
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_MAX_RESULTS=12
SEARXNG_SECRET=genesis-local-change-me

# Fully local speech-to-text through whisper.cpp. Point these at your local executable and GGML model.
# Windows example: C:/Tools/whisper.cpp/build/bin/Release/whisper-cli.exe
WHISPER_CPP_BINARY=
# Windows example: C:/Tools/whisper.cpp/models/ggml-base.en.bin
WHISPER_CPP_MODEL=
VOICE_TIMEOUT_SECONDS=120
VOICE_MAX_AUDIO_BYTES=25000000

# Cognitive memory + shadow prompt evolution.
MEMORY_CONSOLIDATION_MAX_RECORDS=200
EVOLUTION_MAX_VARIANTS=3
EVOLUTION_MAX_CASES=10

# Safety / execution
APPROVAL_TTL_SECONDS=600
MAX_FILE_WRITE_BYTES=1000000
