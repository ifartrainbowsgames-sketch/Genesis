# Core
APP_NAME=Genesis
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WEB_ORIGIN=http://localhost:3000
WORKSPACE_ROOT=./workspace
# Optional semicolon-separated parent folders the in-app repository selector may browse.
# Example: C:/Code;D:/Projects
WORKSPACE_ALLOWED_ROOTS=

# Database
DATABASE_URL=postgresql+asyncpg://genesis:genesis@localhost:5432/genesis

# Local AI (recommended)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional GitHub adapter (fine-grained token recommended)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Optional MCP v2 Streamable HTTP servers. Genesis only connects to endpoints listed here.
# Example: [{"name":"local-tools","url":"http://127.0.0.1:9000/mcp","enabled":true}]
MCP_SERVERS_JSON=[]

# Source-tracked web research. `docker compose up -d searxng` starts the bundled local broker.
SEARXNG_URL=http://127.0.0.1:8080
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_MAX_RESULTS=12
SEARXNG_SECRET=genesis-local-change-me

# Safety / execution
APPROVAL_TTL_SECONDS=600
MAX_FILE_WRITE_BYTES=1000000
